{
  "name": "geditor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build:wasm": "wasm-pack build ./wasm-lib --target web --release",
    "dev:wasm": "cargo watch -C ./wasm-lib -w src -s \"wasm-pack build --target web --release\"",
    "dev": "vite",
    "build": "npm run build:wasm && tsc && vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^25.0.10",
    "eslint": "^9.39.2",
    "globals": "^17.2.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.54.0",
    "vite": "^7.2.4",
    "vite-plugin-wasm": "^3.5.0",
    "vite-tsconfig-paths": "^6.0.5"
  }
}
